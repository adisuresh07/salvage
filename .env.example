SALVAGE_MODE=demo
SALVAGE_LLM=off
SALVAGE_DATABASE_PATH=data/salvage.db
SALVAGE_WEBHOOK_SECRET=replace-with-a-test-mode-webhook-secret

# Opt-in connected simulator; keep secrets in your ignored .env, never in VITE_*.
SALVAGE_SIMULATOR_ENABLED=false
SALVAGE_SIMULATOR_DATABASE_PATH=data/salvage-simulator.db
OLLAMA_API_KEY=
SALVAGE_OLLAMA_MODEL=gpt-oss:20b
SALVAGE_RAZORPAY_KEY_ID=
SALVAGE_RAZORPAY_KEY_SECRET=
SALVAGE_PUBLIC_WEBHOOK_URL=
